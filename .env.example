# KV Eendracht — environment variables.
# Copy to .env and fill in. NEVER commit .env with real values.
#
# Only EXPO_PUBLIC_* variables are compiled into the client bundle. Anything placed
# there is public. Everything else is server-side only. See CLAUDE.md rule 7.
#
# LOCAL DEVELOPMENT: pick ONE password and use it for all four fields marked
# <local-dev-password> below, plus MINIO_ROOT_PASSWORD. One credential to remember,
# and it is safe here because RLS enforcement depends on WHICH ROLE you connect as,
# never on the password — kv_api sharing a password with kv_owner still leaves
# kv_api without BYPASSRLS. Minimum 8 characters, required by MinIO.
#
# PRODUCTION MUST NOT SHARE VALUES. Generate a distinct secret per field with
#   openssl rand -base64 48
# and supply them from the host environment, never from a file in the repo.

# ─────────────────────────────────────────────────────────── database
POSTGRES_DB=kv_eendracht
POSTGRES_USER=kv_owner
POSTGRES_PASSWORD=<local-dev-password>
POSTGRES_PORT=5432

# Roles created by infra/postgres/init/01-roles.sh.
# kv_api is deliberately NOT a superuser and NOT BYPASSRLS — see ADR-0003.
#
# Read at INIT ONLY. Changing these later has no effect until the data volume is
# destroyed: a populated data directory makes Postgres skip its init scripts
# entirely, and it will report healthy while missing every role. Run
# `docker compose down -v` after changing them.
KV_MIGRATOR_PASSWORD=<local-dev-password>
KV_API_PASSWORD=<local-dev-password>

# The API connects as kv_api so that RLS applies to it.
DATABASE_URL=postgresql://kv_api:<local-dev-password>@localhost:5432/kv_eendracht
# Migrations connect as kv_migrator.
MIGRATION_DATABASE_URL=postgresql://kv_migrator:<local-dev-password>@localhost:5432/kv_eendracht

# ─────────────────────────────────────────────────────────── auth
# Generate with: openssl rand -base64 48
# These must be different from each other.
JWT_SECRET=generate-me-openssl-rand-base64-48
JWT_REFRESH_SECRET=generate-me-a-different-one
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# ─────────────────────────────────────────────────────────── storage (MinIO)
MINIO_ROOT_USER=kvadmin
MINIO_ROOT_PASSWORD=<local-dev-password>
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-1
S3_FORCE_PATH_STYLE=true
S3_BUCKET_MEDIA=media
S3_BUCKET_NEWS=news
S3_BUCKET_AVATARS=avatars
UPLOAD_MAX_BYTES=5242880

# ─────────────────────────────────────────────────────────── mail
# Mailpit in development; a real relay in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="KV Eendracht <noreply@kveendracht.nl>"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─────────────────────────────────────────────────────────── api
NODE_ENV=development
API_PORT=3000
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081,http://localhost:8090,http://localhost:19006
LOG_LEVEL=debug

# ─────────────────────────────────────────────────────────── tooling
ADMINER_PORT=8080

# ─────────────────────────────────────────────────────────── client
# PUBLIC. Compiled into the iOS, Android and web bundles.
EXPO_PUBLIC_API_URL=http://localhost:3000
