{
  "name": "kv-eendracht",
  "version": "2.0.0",
  "private": true,
  "description": "Cross-platform app for Kaatsvereniging KV Eendracht (Frisian handball)",
  "repository": {
    "type": "git",
    "url": "git@github.com:evanvansertima/kv-eendracht.git"
  },
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "verify": "pnpm --filter @kv/domain verify",
    "db:migrate": "pnpm --filter @kv/api db:migrate",
    "db:seed": "pnpm --filter @kv/api db:seed",
    "docs:sync": "node scripts/sync-docs.mjs",
    "up": "docker compose -f infra/docker-compose.yml up -d",
    "down": "docker compose -f infra/docker-compose.yml down",
    "logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "eslint": "^9.39.5",
    "pino-pretty": "^13.1.3",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  }
}
