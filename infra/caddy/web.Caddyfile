# Serves the exported web app inside its own container.
#
# The edge Caddy (infra/caddy/Caddyfile) terminates TLS and proxies here; this one only
# serves files, so it listens on plain HTTP.
:8080 {
	root * /srv
	encode gzip zstd

	# Hashed asset filenames never change contents, so they can be cached hard.
	@immutable path /_expo/* /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# HTML must not be cached, or a deploy leaves people on the old bundle.
	@html path *.html /
	header @html Cache-Control "no-cache"

	# Static export writes a document per route; fall back to index.html so a deep link
	# still resolves rather than 404ing.
	try_files {path} {path}/index.html /index.html
	file_server
}
