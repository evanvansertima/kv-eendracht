# Metro (React Native's bundler) does not resolve pnpm's symlinked node_modules.
# Without this, `expo start` fails with module-resolution errors that look like
# missing dependencies. See docs/Decisions/ADR-0004-pnpm-monorepo.md.
node-linker=hoisted

# Surface peer dependency problems rather than failing the install outright —
# the Expo/React Native ecosystem has many loose peer ranges.
strict-peer-dependencies=false
auto-install-peers=true
